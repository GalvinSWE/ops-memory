{
  "name": "ops-memory-monorepo",
  "private": true,
  "type": "module",
  "description": "Operational memory for property management: evidence-backed facts about every unit, extracted by Claude from tickets, reviews and messages.",
  "workspaces": [
    "packages/core",
    "packages/store-sqlite",
    "packages/llm-anthropic",
    "packages/connector-cleanover",
    "packages/mcp",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && tsx --test \"packages/*/test/**/*.test.ts\"",
    "ops-memory": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
