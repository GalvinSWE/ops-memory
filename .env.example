# Read by examples/cleanover/ops-memory.config.ts. Copy to .env and fill in; .env is git-ignored.

# Claude API. Leave unset if you are signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# CleanOver Postgres, read-only. Prefer a dedicated read-only role (see docs/cleanover.md).
CLEANOVER_DATABASE_URL=postgres://ops_memory_reader:password@localhost:5432/cleanover

# Optional: only read one business.
CLEANOVER_BUSINESS_ID=

# Where ops-memory keeps its own facts (SQLite file).
OPS_MEMORY_DB=./ops-memory.db
